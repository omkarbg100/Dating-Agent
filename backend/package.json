{
  "name": "agentic-dating-backend",
  "version": "1.0.0",
  "description": "Node.js & Express backend for Agentic Dating website",
  "main": "src/app.js",
  "type": "module",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "keep-alive": "node keep-alive.js",
    "start:all": "concurrently --names server,pinger --prefix-colors blue,magenta \"node src/app.js\" \"node keep-alive.js\"",
    "dev:all": "concurrently --names server,pinger --prefix-colors blue,magenta \"node --watch src/app.js\" \"node keep-alive.js\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongodb-memory-server": "^10.1.3",
    "mongoose": "^8.9.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
